# loadlab configuration (copy to .env)
LOADLAB_BASE_URL=http://host.docker.internal:3080
LOADLAB_MONGO_URI=mongodb://host.docker.internal:27017/LibreChat
LOADLAB_MEILI_URL=http://host.docker.internal:7700
LOADLAB_MEILI_KEY=
LOADLAB_RAG_URL=http://host.docker.internal:8000
LOADLAB_METRICS_SECRET=
LOADLAB_UPLOADS_DIR=/librechat-uploads
LOADLAB_PG_DSN=postgresql://myuser:mypassword@host.docker.internal:5432/mydatabase
# optional gateway (LiteLLM / Azure) for provider-level 429 visibility
# LOADLAB_PROVIDER_URL=http://host.docker.internal:4000/v1
# LOADLAB_PROVIDER_KEY=sk-...
# LOADLAB_LLM_METRICS_URL=http://host.docker.internal:4000/metrics
# LOADLAB_LLM_METRICS_KEY=sk-...
# restart command used by `loadlab env apply/restore`
# LOADLAB_RESTART_CMD=docker restart LibreChat
